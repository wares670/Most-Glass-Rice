{
  "layer": "top",
  "position": "top",
  "spacing": 15,
  "height": 35,
  "margin-top": 3,
  "margin-left": 300,
  "margin-right": 300,

  "modules-left": [
  "custom/tab",
  "hyprland/workspaces",
  "custom/cliphist"
  ],
  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "wireplumber",
    "backlight",
    "battery",
    "custom/notification",
    "custom/lock",
    "custom/power"
  ],
	
  "network": {
    "interface": "wlp1s0",
    "format": "<span font='JetBrainsMono NF'>{icon}</span>",
    "on-click": "kitty -e nmtui",
    "tooltip": false,
    "icon": " "
  },


  "custom/tab": {
    "format": "\u200B  ",
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
   },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [""]
    }
  },

  "battery":{
    "format": "{icon} {icon} {capacity}%",
    "icon": "󱐋"
  },

  "clock": {
    "format": "{:%I:%M %p}"
  },
  "custom/cliphist": {
    "format": "\ued7b",
    "on-click": "cliphist list | rofi -dmenu -p 'Clipboard' | cliphist decode | wl-copy",
    "on-click-right": "cliphist wipe", // Right-click clears your clipboard history
    "tooltip": true,
    "tooltip-format": "Left-click: Open History\nRight-click: Clear History"
},



  "custom/lock": {
    "format": " ",
    "on-click": "hyprlock",
    "tooltip": true,
    "tooltip-format": "Lock Screen"
  }
}
